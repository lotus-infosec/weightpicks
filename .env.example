# WeightPicks install-time settings. Copy to `.env` next to docker-compose.yml on the
# production host (install.sh generates it). `.env` is git-ignored: never commit it.
#
# Development does NOT use this file: run `scripts/init-dev-env.sh` once, and
# docker-compose.dev.yml reads ~/.config/weightpicks/dev.env (outside the repo).
# Integration secrets (Workers AI, webhooks, SMTP, Garmin) are entered in /setup and
# stored encrypted in the database, not here.

# --- Image ---
WP_IMAGE=ghcr.io/lotus-infosec/weightpicks  # published image (install.sh sets weightpicks for --build)
WP_VERSION=                          # a release, e.g. 1.0.0 (install.sh fills it; upgrade.sh changes it)
# --- Network ---
WP_BIND=127.0.0.1:8000               # host:port the web container publishes; keep 127.0.0.1
WP_BASE_URL=https://picks.example.com  # public URL behind the tunnel (links in email/Discord)
# --- Instance defaults (only pre-fill /setup; the settings row is authoritative after setup) ---
WP_TIMEZONE=America/New_York       # IANA zone for weigh-in windows and daily totals
WP_UNIT=lb                           # lb | kg
# --- Security ---
APP_SECRET_KEY=                      # 32+ random bytes, base64; install.sh generates it. Losing it = re-enter integration secrets
WP_COOKIE_SECURE=true                # keep true; dev only may set false for a plain-http LAN phone test (docs/phone-test-lan.md)
# --- Runtime ---
APP_ENV=production                   # production | dev  (dev enables SimClock + /dev routes)
DATA_PROVIDER=garmindb               # garmindb | simulated
SIM_SEED=42                          # simulated provider seed (dev/alpha)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING
LOG_FORMAT=json                      # json | console
# --- Limits ---
AI_DAILY_NEURON_CAP=5000             # hard cap enforced in code (free tier is 10,000/day)
# AI_MODEL_JSON=@cf/meta/llama-3.1-8b-instruct           # prop suggestions (JSON Mode)
# AI_MODEL_TEXT=@cf/meta/llama-3.1-8b-instruct-fp8-fast # stat-update wording
BACKUP_RETENTION=7                   # automatic nightly backups kept
